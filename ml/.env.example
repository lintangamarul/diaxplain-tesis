# DiaXplain ML Service Environment Configuration
SERVICE_TOKEN=diaxplain-internal-secret-token-2026
MODEL_DIR=artifacts/model_v1

# Third-Party LLM API Configuration (OpenAI-Compatible / Gemini / Groq / OpenRouter / Anthropic)
# Supported providers: openai_compatible, gemini, anthropic, template_fallback
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=45
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
PROMPT_VERSION=p1.0

